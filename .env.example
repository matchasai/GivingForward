# MongoDB Configuration (primary datastore)
# Provide via environment variables. Prefer SPRING_DATA_MONGODB_URI, fallback to MONGODB_URI.
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017
SPRING_DATA_MONGODB_DATABASE=GivingForward

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this-in-production
# In milliseconds (1 day = 86400000)
JWT_EXPIRATION=86400000

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
# Note: Use Gmail App Password, not your regular password

# Frontend URL (for password reset emails)
FRONTEND_URL=http://localhost:5173

# Server Configuration
SERVER_PORT=8081

# File Upload Configuration
UPLOAD_PATH=uploads/

# Razorpay Configuration (use TEST keys for development)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
